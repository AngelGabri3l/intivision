# Conexión del agente con el servidor. Copia este archivo a edge/.env (git lo ignora) y completa los dos valores.
# El .env es SECRETO: contiene el token de esta mini PC. No lo subas a git, no lo pegues en chats ni lo compartas.

# La dirección del servidor.
#   - Normal:  https://intivision.online
#   - Si pruebas con un túnel SSH (ssh -N -L 8000:localhost:8000 ubuntu@IP-DEL-SERVIDOR):  http://localhost:8000
#   El agente rechaza http:// hacia un equipo remoto: el token viajaría sin cifrar.
SERVER_URL=https://intivision.online

# El token de esta mini PC (43 letras, números, guion y guion bajo). Lo crea el administrador del servidor con:
#   docker compose exec backend python -m backend.manage create-edge-device --community-slug TU-COMUNIDAD --name mini-pc-1
# Se muestra UNA sola vez. Pégalo aquí sin comillas ni espacios.
EDGE_TOKEN=

# --- Opcionales ---
# Imagen liviana, sin el motor de detección (solo cámaras). Después: docker compose build
#MOTOR=0
# Zona horaria de la mini PC (el horario sensible, de 22 a 6 h, se mide con esta hora local).
#AGENT_TZ=America/Lima
